{
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "trailingSlash": true,
    "ignore": ["firebase.json", "README.md", "**/.*", "**/node_modules/**", "hub/**", "tools/**"],
    "headers": [
      {
        "source": "**/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/tools.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/manifest.webmanifest",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
